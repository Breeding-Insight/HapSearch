# Application
APP_ENV=development
APP_PORT=5000
DEBUG_MODE=true
SECRET_KEY=change-me

# SQLite database (built by the import scripts; see docs/cloud-run.md)
SQLITE_DB_PATH=data/hapsearch.db
# true on Cloud Run, where the file ships read-only inside the image
SQLITE_READ_ONLY=false
# Megabytes of decoded presence matrices each worker keeps in memory
PRESENCE_CACHE_MAX_MB=100

# Cloud Run: public GitHub Pages landing page for signed-out visitors
HAPSEARCH_LANDING_URL=

# ORCID allowlist: sqlite (users table) locally, firestore on Cloud Run
# (the default whenever K_SERVICE is set)
HAPSEARCH_USER_STORE=sqlite
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE=hapsearch-db

# ORCID OAuth
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# Local-dev-only ORCID bypass. This only works when APP_ENV=local-dev.
BYPASS_ORCID_AUTH=false

# Development ORCID whitelist bypass. This still requires ORCID sign-in.
BYPASS_AUTH_WHITELIST=false
BYPASS_DEV_ORCID=0000-0000-0000-0000
BYPASS_DEV_NAME=Developer
BYPASS_DEV_ROLE=admin

# Optional metadata sync
DROPBOX_ACCESS_TOKEN=
