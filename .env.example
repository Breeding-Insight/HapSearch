# Application
APP_ENV=development
APP_PORT=5000
DEBUG_MODE=true
SECRET_KEY=change-me

# Microsoft SQL Server
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=HaploSearch
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrong!Passw0rd
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_TRUST_SERVER_CERTIFICATE=true

# Required by the bundled SQL Server container in docker-compose.dev-local.yml
ACCEPT_EULA=Y
SA_PASSWORD=YourStrong!Passw0rd

# ORCID OAuth
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# Local-dev-only ORCID bypass. This only works when APP_ENV=local-dev.
BYPASS_ORCID_AUTH=false

# Development ORCID whitelist bypass. This still requires ORCID sign-in.
BYPASS_AUTH_WHITELIST=false
BYPASS_DEV_ORCID=0000-0000-0000-0000
BYPASS_DEV_NAME=Developer
BYPASS_DEV_ROLE=admin

# Optional metadata sync
DROPBOX_ACCESS_TOKEN=
